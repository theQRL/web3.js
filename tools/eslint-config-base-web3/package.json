		"eslint-plugin-jest": "29.15.4",
		"eslint-plugin-no-null": "1.0.2",
		"eslint-plugin-tsdoc": "0.5.2",
		"@eslint/js": "10.0.1",
		"eslint-plugin-import-x": "4.17.1",
		"globals": "17.7.0"
	}
